# OBSERVA Environment Configuration
PROJECT_NAME="OBSERVA - Multimodal Accessibility OS"
VERSION="2.0.0"
ENV="development"

# API & WebSocket Endpoints
API_PREFIX="/api"
PORT=8000
HOST="127.0.0.1"

# Database
DATABASE_URL="sqlite:///./observa.db"

# AI Vision Models
YOLO_MODEL="yolo11n.pt"
# Optional Gemini API Key for multimodal reasoning proxy
GEMINI_API_KEY=""

# Emergency Escalation
DEFAULT_ESCALATION_TIMEOUT=60
DEMO_MODE_DEFAULT=true
